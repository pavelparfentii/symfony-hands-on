{% if users|length > 0 %}
<div class="grid grid-cols-1 xl:grid-cols-2">
    {% for otherUser in users %}
        <div class="flex justify-between items-center">
            <div>
                <a href="{{ path('app_user_profile', {id: otherUser.id}) }}">
                    <div class="text-lg">{{ otherUser.userProfile.name ?? otherUser.email }}</div>
                    <div class="text-gray-300 dark:text-gray-600">{{ otherUser.email }}</div>
                </a>
            </div>
            <div>
                {{ include('follower/_follow_button.html.twig', {userToFollow: otherUser}) }}
            </div>
        </div>
    {% endfor %}
</div>
{% else %}
<div class="w-full mb-4 text-center">
    <div class="font-bold text-2xl text-gray-300 dark:text-gray-600">
        Nothing To Show

    </div>
    <div class="text-gray-300 dark:text-gray-600">
        The list is currently empty.
    </div>
</div>

{% endif %}