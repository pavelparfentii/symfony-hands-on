{% extends 'base.html.twig' %}

{% block body %}
<div>
    {% if messages|length > 0 %}
        {% for key,message in messages|slice(0, limit) %}
        <h1>{{ message.message }}</h1>
            <a href="{{ path('app_message', {id:key})  }}">{{message.message}}</a>
            {{ include('test/_message.html.twig', {message: message}) }}
        {% endfor %}
    {% else %}
        <div>There is nothing here</div>
    {% endif %}
</div>
{% endblock %}